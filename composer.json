{
    "name": "mohan-devstack/magento2-product-queue-save",
    "description": "Magento 2 module — Save all product types asynchronously via message queue (simple, configurable, grouped, bundle, downloadable). No browser timeouts.",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Mohan",
            "email": "mohandevstack@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "magento/framework": "*",
        "magento/module-catalog": "*",
        "magento/module-configurable-product": "*",
        "magento/module-catalog-inventory": "*",
        "magento/module-store": "*",
        "magento/module-backend": "*",
        "magento/module-downloadable": "*",
        "magento/module-bundle": "*",
        "magento/module-grouped-product": "*",
        "magento/module-message-queue": "*",
        "magento/module-asynchronous-operations": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Mohan\\ProductQueueSave\\": ""
        }
    }
}
